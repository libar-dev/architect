{
  "name": "@libar-dev/architect",
  "version": "2.0.0-pre.1",
  "description": "Libar Architect — engineering lifecycle platform for AI-assisted development. Kitchen-sink meta-package that installs the full toolchain (core, projection, guard, cli, mcp) and re-exports every CLI bin.",
  "license": "(MIT AND BUSL-1.1)",
  "author": "Libar AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libar-dev/architect.git",
    "directory": "packages/architect"
  },
  "bugs": {
    "url": "https://github.com/libar-dev/architect/issues"
  },
  "homepage": "https://github.com/libar-dev/architect#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "architect": "./bin/architect.js",
    "architect-generate": "./bin/architect-generate.js",
    "architect-guard": "./bin/architect-guard.js",
    "architect-lint-patterns": "./bin/architect-lint-patterns.js",
    "architect-lint-steps": "./bin/architect-lint-steps.js",
    "architect-validate": "./bin/architect-validate.js",
    "architect-mcp": "./bin/architect-mcp.js"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "node --test test/smoke.test.mjs",
    "prepack": "pnpm clean && pnpm build"
  },
  "dependencies": {
    "@libar-dev/architect-cli": "workspace:*",
    "@libar-dev/architect-core": "workspace:*",
    "@libar-dev/architect-guard": "workspace:*",
    "@libar-dev/architect-mcp": "workspace:*",
    "@libar-dev/architect-projection": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "typescript": "^5.8.2"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "architect",
    "libar",
    "libar-architect",
    "ai-context",
    "ai-assisted-development",
    "pattern-graph",
    "docs-as-code",
    "gherkin",
    "bdd",
    "mcp",
    "cli"
  ]
}
