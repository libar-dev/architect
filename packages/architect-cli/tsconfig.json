{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.architect-base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "./src",
    "outDir": "./dist",
    "composite": true,
    "incremental": true,
    "disableSourceOfProjectReferenceRedirect": true
  },
  "references": [
    {
      "path": "../architect-core"
    },
    {
      "path": "../architect-projection"
    },
    {
      "path": "../architect-guard"
    }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
