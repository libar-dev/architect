{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "baseUrl": ".",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*", "tests/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
